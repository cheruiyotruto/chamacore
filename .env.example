APP_NAME="Chama Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Nairobi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_KE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chama_core
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# Trust X-Forwarded-* headers from a reverse proxy. Use * only when the app is
# unreachable except through that proxy; otherwise list IPs/CIDRs.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@chamacore.local"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_TOKEN_PREFIX=chama_

# Platform owner / first super administrator (created by the seeder)
PLATFORM_ADMIN_NAME="Platform Administrator"
PLATFORM_ADMIN_EMAIL=admin@chamacore.test
PLATFORM_ADMIN_PASSWORD="ChangeMe!2026"

# Demo group seed switch — never enable in production
CHAMA_SEED_DEMO=true

# M-Pesa Daraja (per-group values can override these)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=

# M-Pesa B2B / B2C payouts (send money to PayBills, tills or phones)
MPESA_B2B_SHORTCODE=
MPESA_B2B_INITIATOR=
MPESA_B2B_SECURITY_CREDENTIAL=
MPESA_B2B_RESULT_URL=
MPESA_B2B_QUEUE_URL=
MPESA_B2B_CALLBACK_SECRET=

# Bank transfer payouts (generic outbound transfer API)
BANK_PAYOUT_ENDPOINT=
BANK_PAYOUT_TOKEN=
BANK_PAYOUT_CALLBACK_URL=
BANK_PAYOUT_CALLBACK_SECRET=

# M-Pesa float / airtime purchases from member wallets.
# "manual" queues purchases for a treasurer; "http" calls FLOAT_ENDPOINT.
FLOAT_DRIVER=manual
FLOAT_ENDPOINT=
FLOAT_TOKEN=
FLOAT_CALLBACK_URL=
FLOAT_CALLBACK_SECRET=
FLOAT_NETWORK=mpesa

# SMS
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_ID=CHAMACORE

# WhatsApp (generic HTTP Business API transport)
WHATSAPP_DRIVER=log
WHATSAPP_API_KEY=
WHATSAPP_FROM=
WHATSAPP_ENDPOINT=

# Push
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Backups
BACKUP_DISK=local
BACKUP_RETENTION_DAYS=30

# Docker Compose only (see docs/DEPLOYMENT.md). The compose file creates a
# dedicated MySQL user from these values; DB_HOST, DB_USERNAME and DB_PASSWORD
# above are ignored by the app container. Change the passwords in production.
APP_PORT=8080
CHAMA_DB_USER=chama
CHAMA_DB_PASSWORD=change-me-before-production
MYSQL_ROOT_PASSWORD=change-root-password-before-production
